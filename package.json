{
  "name": "@goblinlife/reaction-matrix",
  "version": "0.2.0",
  "private": true,
  "description": "A hypercube of reactions: one drop-in React button that opens a draggable 4D figure and returns a four-axis emotional vector. Replaces upvotes and emoji reactions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/C-Vac/reaction-matrix.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./math": {
      "types": "./src/math.ts",
      "default": "./src/math.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm --prefix demo run dev"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "reactions",
    "upvote",
    "emoji",
    "tesseract",
    "hypercube",
    "4d",
    "ui"
  ],
  "homepage": "https://github.com/C-Vac/reaction-matrix#readme",
  "bugs": {
    "url": "https://github.com/C-Vac/reaction-matrix/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ]
}
